# Copie para .env e ajuste. O .env NÃO vai para o Git.

# Receptor DICOM (o que vai na tela DICOM do ultrassom)
# Cada clínica usa o próprio AE (VETUS_C0001...). AE_TITLE é o AE antigo, ainda aceito:
AE_TITLE=MINIPACS
# Clínica que recebe os exames enviados ao AE antigo (ex.: VETUS_C0001). Vazio = ficam sem clínica.
AE_LEGADO_CLINICA=
DICOM_PORT=2345
# Só aceita estes equipamentos (vazio = qualquer um). Ex.: MindrayVet
ALLOWED_AES=
# true = apaga o .dcm original depois de gerar as fotos/PDF
APAGAR_ORIGINAIS=true
# segundos sem receber imagens para considerar o exame completo
IDLE_SECONDS=5

# Área web antiga (protótipo)
WEB_PORT=8080
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Plataforma (clínicas, usuários, laudos)
PLATAFORMA_PORT=5080
# Endereço do sistema para quem está fora (QR code de verificação no PDF). Na nuvem: https://seu-dominio
VETUS_URL_PUBLICA=http://localhost:5080
# Senha do banco de dados PostgreSQL
POSTGRES_PASSWORD=troque-esta-senha-do-banco
# Administrador do sistema: criado no primeiro início (depois disso, mudar aqui não altera nada)
VETUS_ADMIN_EMAIL=admin@vetus.local
VETUS_ADMIN_SENHA=troque-esta-senha-admin
# Chave da comunicação interna receptor -> plataforma (qualquer texto longo e aleatório)
VETUS_CHAVE_INTERNA=troque-esta-chave-interna
# IA do pré-laudo. Ordem: a primeira é a principal, a segunda é reserva (claude,gemini ou gemini,claude)
IA_ORDEM=claude,gemini
# Claude (Anthropic): chave em https://console.anthropic.com
ANTHROPIC_API_KEY=
# claude-opus-5-5 (melhor), claude-sonnet-5-5 (metade do preço), claude-haiku-5-5 (o mais barato)
CLAUDE_MODELO=claude-opus-5-5
# low, medium, high, max (mais alto = mais análise e mais custo)
CLAUDE_ESFORCO=high
# Gemini (Google): chave do Vertex AI (com GEMINI_PROJETO) ou do AI Studio (sem projeto)
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.1-pro-preview
GEMINI_PROJETO=889125416356
GEMINI_LOCAL=global
# Exames gerados ao mesmo tempo e máximo de fotos enviadas por exame
IA_PARALELO=2
IA_MAX_IMAGENS=15
# true = não chama IA nenhuma; gera um pré-laudo de exemplo (testes)
IA_SIMULADA=false

# API de ingestão de servidores locais (ainda não implementada)
INGESTAO_HABILITADA=false

TZ=America/Sao_Paulo
