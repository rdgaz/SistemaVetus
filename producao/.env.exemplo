# Exemplo do .env de PRODUÇÃO (VPS: /opt/vetus/producao/.env, permissão 600). Nunca coloque o .env real no Git.
# Senhas internas: gere no próprio servidor com  openssl rand -base64 32 | tr -d '/+=' | cut -c1-40

# Versão das imagens (latest = a última publicada; para voltar, use a versão ou o commit publicado)
VERSAO_PLATAFORMA=latest
VERSAO_RECEPTOR=latest

# Banco
POSTGRES_PASSWORD=gere-no-servidor

# Chave interna (API /api/interno, usada pelo receptor no caminho antigo)
VETUS_CHAVE_INTERNA=gere-no-servidor

# Administrador inicial (só usado se o banco estiver vazio; na migração os usuários já vêm do banco)
VETUS_ADMIN_EMAIL=
VETUS_ADMIN_SENHA=

# E-mail do sistema (avisos); vazio = só o aviso dentro do sistema
VETUS_SMTP_HOST=
VETUS_SMTP_PORTA=587
VETUS_SMTP_SEGURANCA=starttls
VETUS_SMTP_USUARIO=
VETUS_SMTP_SENHA=
VETUS_SMTP_REMETENTE=

# IA do pré-laudo
IA_ORDEM=claude,gemini
ANTHROPIC_API_KEY=
CLAUDE_MODELO=claude-opus-5-5
CLAUDE_ESFORCO=high
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.1-pro-preview
GEMINI_PROJETO=
GEMINI_LOCAL=global
IA_PARALELO=2
IA_MAX_IMAGENS=30
