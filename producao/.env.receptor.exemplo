# Exemplo do .env do RECEPTOR em produção (VPS: /opt/vetus/producao/.env.receptor, permissão 600). Nunca no Git.
# Porta, certificado e endereço da plataforma já estão no docker-compose.yml.

# AE "antigo" do servidor e a clínica que recebe o que chegar nele
AE_TITLE=MINIPACS
AE_LEGADO_CLINICA=

# Mesma chave do .env da plataforma (VETUS_CHAVE_INTERNA): valida o AE de cada clínica em /api/interno
VETUS_CHAVE_INTERNA=igual-ao-env-da-plataforma

# Token de serviço criado na plataforma em "Receptores (sistema)" (aparece uma vez só).
# Com ele, os exames vão pela API de ingestão (rede interna: http://plataforma:8080/api/ingestao/v1).
VETUS_TOKEN_INGESTAO=

# Aparelhos aceitos (AE de origem, separados por vírgula). Vazio = qualquer um (o AE chamado já identifica a clínica).
ALLOWED_AES=

IDLE_SECONDS=5
APAGAR_ORIGINAIS=true
PAINEL_PORTA=0
DEBUG=false
