<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vetus.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.12.0" />
    <PackageReference Include="MailKit" Version="5.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" PrivateAssets="all" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="QRCoder" Version="1.9.0" />
    <PackageReference Include="QuestPDF" Version="2026.9.2" />
    <PackageReference Include="SkiaSharp" Version="4.157.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.157.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- banco de frases do "Laudo Fácil" (modelos de texto por órgão e condição) -->
    <Content Update="Recursos/frases.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

